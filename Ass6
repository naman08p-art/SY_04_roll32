Bottom down approach
def knapsack_bottom_up(values, weights, W):
    n = len(values)

    # dp[i][w] = maximum value using first i items
    # with capacity w
    dp = [[0] * (W + 1) for _ in range(n + 1)]

    for i in range(1, n + 1):
        for w in range(W + 1):

            if weights[i - 1] <= w:
                # Include or exclude the current item
                dp[i][w] = max(
                    dp[i - 1][w],
                    dp[i - 1][w - weights[i - 1]] + values[i - 1]
                )
            else:
                # Cannot include current item
                dp[i][w] = dp[i - 1][w]

    return dp[n][W]


# Example
values = [60, 100, 120]
weights = [10, 20, 30]
W = 50

print("Maximum value:", knapsack_bottom_up(values, weights, W))

#output
Maximum value: 220

Top down approach

def knapsack_top_down(values, weights, W):
    n = len(values)

    # memo[i][w] stores the result for
    # first i items and capacity w
    memo = [[-1] * (W + 1) for _ in range(n + 1)]

    def solve(i, w):
        # Base case
        if i == 0 or w == 0:
            return 0

        # Return already calculated result
        if memo[i][w] != -1:
            return memo[i][w]

        # If current item is too heavy, exclude it
        if weights[i - 1] > w:
            memo[i][w] = solve(i - 1, w)

        else:
            # Option 1: exclude the item
            exclude = solve(i - 1, w)

            # Option 2: include the item
            include = (
                values[i - 1]
                + solve(i - 1, w - weights[i - 1])
            )

            memo[i][w] = max(include, exclude)

        return memo[i][w]

    return solve(n, W)


# Example
values = [60, 100, 120]
weights = [10, 20, 30]
W = 50

print("Maximum value:", knapsack_top_down(values, weights, W))

#output
maximum value:220
